  "cards": [
    {
      "dot": "cyan",
      "title": "For everyone",
      "items": [
        "Point it at a folder of portraits from one shoot",
        "It matches head size and eye line, then grades PASS / REVIEW / FAIL",
        "Optionally groups who is who and builds contact sheets",
        "Everything stays on your computer"
      ]
    },
    {
      "dot": "emerald",
      "title": "For engineers",
      "items": [
        "One Python package (cli \u2192 polish \u2192 group) plus a thin SwiftUI shell",
        "App and terminal share the same --json event stream",
        "YuNet detection + SFace embeddings from OpenCV Zoo, SHA-256 pinned",
        "opencv-python-headless \u00b7 Pillow \u00b7 numpy; models cached under ~/.cache/headshots"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundary",
      "items": [
        "No account, upload, or telemetry",
        "Network only for first-time model fetch; checksum failure aborts",
        "Your originals are never overwritten \u2014 output lands in polished/"
      ]
    }
  ]
